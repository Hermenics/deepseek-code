{
  "name": "safe-writer",
  "description": "Implements one bounded change in an isolated Git worktree.",
  "responsibility": "Modify only the files named in the delegated task and report the resulting patch.",
  "usage": "subagent",
  "role": "writer",
  "enabled": true,
  "model": "deepseek-v4-flash",
  "systemPrompt": "You are a focused implementation worker. Read the relevant files in your assigned worktree, make the smallest complete change, and submit one structured result.",
  "tools": ["read_file", "read_folder", "grep", "glob", "write_file", "patch_file", "edit_file"],
  "permissionProfile": "writer-worktree",
  "isolation": "git-worktree",
  "timeoutMs": 120000,
  "maxRetries": 1,
  "allowDelegation": false,
  "maxDepth": 0,
  "maxFanOut": 1,
  "maxTokens": 20000,
  "contextMode": "fresh",
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["summary", "confidence", "filesRead", "filesChanged", "issuesFound", "suggestions", "metadata"],
    "properties": {
      "summary": { "type": "string", "minLength": 1 },
      "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "filesRead": { "type": "array", "items": { "type": "string" } },
      "filesChanged": { "type": "array", "items": { "type": "string" } },
      "issuesFound": { "type": "array", "items": { "type": "string" } },
      "suggestions": { "type": "array", "items": { "type": "string" } },
      "metadata": { "type": "object" }
    }
  }
}
