{
  "name": "@aethelics/deepseek-code",
  "version": "0.4.1",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "deepseek": "dist/cli.mjs"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "scripts": {
    "start": "bun src/index.tsx",
    "dev": "bun --watch src/index.tsx",
    "build": "bun build src/index.tsx --outfile dist/cli.mjs --target node --minify && chmod +x dist/cli.mjs",
    "prepublishOnly": "bun run build"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.6.2",
    "cli-boxes": "^4.0.1",
    "code-excerpt": "^4.0.0",
    "diff": "^9.0.0",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "figures": "^6.1.0",
    "highlight.js": "^11.11.1",
    "ink": "^5.2.1",
    "marked": "^18.0.2",
    "openai": "^6.34.0",
    "react": "^18.3.1",
    "strip-ansi": "^7.2.0",
    "supports-hyperlinks": "^4.4.0",
    "wrap-ansi": "^10.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/diff": "^8.0.0",
    "@types/react": "^18.3.28",
    "typescript": "^5.9.3"
  }
}