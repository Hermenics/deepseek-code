{
  "name": "deepseek-code-cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "deepseek": "./dist/cli.mjs"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "scripts": {
    "start": "bun src/index.tsx",
    "build": "bun build src/index.tsx --outfile dist/cli.mjs --target node --minify --external react-devtools-core && sed -i '1s|.*|#!/usr/bin/env node|' dist/cli.mjs && chmod +x dist/cli.mjs",
    "prepublishOnly": "bun run build"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "execa": "^9.0.0",
    "fast-glob": "^3.3.2",
    "ink": "^5.0.1",
    "openai": "^4.52.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/react": "^18.3.3",
    "typescript": "^5.5.3"
  }
}