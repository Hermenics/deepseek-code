{
  "name": "@aethelics/deepseek-code",
  "version": "0.2.6",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "deepseek": "dist/cli.mjs"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0"
  },
  "scripts": {
    "start": "bun src/index.tsx",
    "dev": "bun --watch src/index.tsx",
    "build": "bun build src/index.tsx --outfile dist/cli.mjs --target bun --minify && sed -i '2{/^\\/\\/ @bun$/d}' dist/cli.mjs && chmod +x dist/cli.mjs",
    "prepublishOnly": "bun run build"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "execa": "^9.0.0",
    "fast-glob": "^3.3.2",
    "ink": "^5.0.1",
    "openai": "^6.34.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/react": "^18.3.3",
    "typescript": "^5.5.3"
  }
}